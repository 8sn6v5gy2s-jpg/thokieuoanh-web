---
// Hand-drawn ink illustrations, all inline SVG.
// Deliberately imperfect paths — slight wobble reads as hand-drawn.
// Stroke-only, currentColor, so they tint with the accent token.
interface Props {
  name: 'sprig' | 'branch' | 'bird' | 'flower' | 'wave';
  class?: string;
  width?: number | string;
  'aria-hidden'?: boolean;
}
const { name, class: className = '', width = 120 } = Astro.props;
---

{
  name === 'sprig' && (
    <svg
      class={className}
      width={width}
      viewBox="0 0 120 120"
      fill="none"
      stroke="currentColor"
      stroke-width="1.15"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      {/* stem — one continuous hand-wobbled line */}
      <path d="M60 112c.6-9-1.8-18.4-2.6-27.6-1-11 .4-22.4 1.4-33.4.5-5.6.2-11.2.4-16.8" />
      {/* left leaves */}
      <path d="M58 84C48.6 84.4 39 80.6 34.6 72.4c6.8-1.6 15 .6 19.8 5.4 1.6 1.6 2.8 3.6 3.6 6.2Z" />
      <path d="M58.8 62C50 61.6 42.4 57 39.6 48.8c6.6-.6 13.6 2.8 17 8.6 1.2 2 1.8 4.2 2.2 4.6Z" />
      <path d="M59.6 42c-6.4-1.8-11.4-6.4-13-13 5.6.4 10.8 4.6 12.8 9.6.6 1.4.9 2.9.2 3.4Z" />
      {/* right leaves */}
      <path d="M61.4 92.4c8.8.8 18.2-2.4 22.4-10.2-6.8-1.8-14.8.2-19.4 4.8-1.6 1.6-2.6 3.6-3 5.4Z" />
      <path d="M61.8 71.2c8.2-.4 15.6-4.6 18.8-12-6.4-.8-13.6 2.2-17.2 7.8-1.2 1.8-1.9 3.6-1.6 4.2Z" />
      <path d="M61.2 51.6c6.6-2.2 11.6-7.2 13.2-13.8-5.6.6-10.8 4.8-12.6 9.8-.6 1.6-1 3.2-.6 4Z" />
      {/* a small open bud at the tip */}
      <path d="M59.2 34.2c-1.8-3.4-1.4-7.6 1.2-10.4 2.4 2.6 3.2 6.6 1.8 10.1" />
      <path d="M61 24.2c-.2-2.6.8-5.2 2.6-7" />
    </svg>
  )
}

{
  name === 'branch' && (
    <svg
      class={className}
      width={width}
      viewBox="0 0 200 80"
      fill="none"
      stroke="currentColor"
      stroke-width="1.15"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M8 62c22-1.4 44.6-3.6 66.4-8.4 21.6-4.8 42.4-12 62.6-19.6 18.4-6.8 36.4-14.2 54.6-20.2" />
      <path d="M52 57.4c-2.6-6.4-8.4-11-15.2-12.4.6 6.4 4.4 12.2 10.2 14.6 1.6.6 3.4.8 5-2.2Z" />
      <path d="M56.4 56.2c.6-7.2 4.8-13.6 11-17 1.2 6.6-1.4 13.8-6.6 17.6-1.8 1.2-3.8 1.4-4.4-.6Z" />
      <path d="M108 40.6c-4.4-5.4-11-8.6-18-8.2 2.4 6 8 10.6 14.4 11.4 1.8.2 3.4 0 3.6-3.2Z" />
      <path d="M114 38.4c-1.6-7-.4-14.4 3.6-20.4 3.6 5.8 3.8 13.2.4 19.2-1 1.8-2.6 2.6-4 1.2Z" />
      <path d="M164 18.4c-4.8-4.4-11.4-6.8-18-6 2.6 5.4 8 9.4 14.2 10" />
    </svg>
  )
}

{
  name === 'bird' && (
    <svg
      class={className}
      width={width}
      viewBox="0 0 100 100"
      fill="none"
      stroke="currentColor"
      stroke-width="1.15"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      {/* body — one wandering line */}
      <path d="M28 60c3.4-8.6 12.6-14.4 22.2-14.6 3.8-.1 7.6.8 11 2.6" />
      <path d="M61.2 48c4.6-4.2 10.4-6.6 16.4-6.8 2.4 0 4.6.4 6.4 1.2-3.6 3.8-8 6.6-12.8 8-1.4.4-2.6.6-2.8 2.6-.6 5.4-3.6 10.2-8.2 13-6.4 3.8-14.6 4-21 0.4" />
      <path d="M39.2 66.4c-4.4 2-8.2 5.6-10.4 10-1.4 2.8-2 5.8-2 8.8 4.6-1.6 8.6-4.6 11.4-8.6 1.4-2 2.4-4.2 3-6.6" />
      {/* wing */}
      <path d="M50 40.6c5.6-6.4 14-9.4 22-8.2-2.4 5.4-7 9.6-12.6 11.6" />
      {/* eye */}
      <circle cx="73.4" cy="45.2" r="1.1" fill="currentColor" stroke="none" />
      {/* beak */}
      <path d="M84 43.8c1.6-.6 3.2-.8 4.8-.6" />
    </svg>
  )
}

{
  name === 'flower' && (
    <svg
      class={className}
      width={width}
      viewBox="0 0 120 120"
      fill="none"
      stroke="currentColor"
      stroke-width="1.1"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      {/* five loose petals around a centre */}
      <path d="M60 52c-4.4-9.6-3.6-20.4 2-29.2 5.2 8.6 6.4 19 2.6 28.6" />
      <path d="M66.4 56.6c8.8-5.6 19.4-6.6 28.8-2.6-7.6 6.4-18 8.8-27.6 6.4" />
      <path d="M64 64.4c8.4 6.2 13.4 16 13.4 26.2-7.6-5.6-12.6-14.6-13.4-24.4" />
      <path d="M54 64.6c-3.6 9.8-11.4 17-21.4 19.4 2.4-8.6 9-15.8 17.4-19" />
      <path d="M51.6 56.4c-8.2-3.4-14.6-10-17.6-18.4 8.6 1.4 16.4 7.2 20.4 15.2" />
      <circle cx="59.4" cy="59.2" r="5.4" />
      {/* stem */}
      <path d="M59.6 65c.6 12 .4 24-.4 36-2.4 1.8-4.4 4.2-5.6 7" />
      {/* a leaf on the stem */}
      <path d="M59.8 84.6c-5.6-.6-10.4-3.8-13-8.6 5.4-.6 10.6 1.8 13.4 6.2" />
      <path d="M59.4 96.4c5.4-1.4 9.6-5.2 11.4-10.4-5.4.2-10.2 3.2-11.8 7.8" />
    </svg>
  )
}

{
  name === 'wave' && (
    <svg
      class={className}
      width={width}
      viewBox="0 0 200 40"
      fill="none"
      stroke="currentColor"
      stroke-width="1.1"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <path d="M4 24c14-9 28-9 42 0 13.4 8.6 27 8.4 40.2-.2 13-8.4 26.8-8.6 40-.4 13 8 26.6 8 39.6.2 11.4-6.6 22-6.4 30 1" />
      <path d="M28 34c11-6.4 22-6.4 33 0 10.6 6.2 21.4 6 32-.4 10.4-6.2 21.4-6.2 31.8-.2 10 5.8 20 5.6 30-1" opacity="0.55" />
    </svg>
  )
}
