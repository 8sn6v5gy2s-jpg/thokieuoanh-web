---
import Base from '../../layouts/Base.astro';
import Ink from '../../components/Ink.astro';
import {
  getPoems,
  slugOf,
  formatDate,
  tagSlug,
  metaDescriptionOf,
} from '../../lib/poems';

export async function getStaticPaths() {
  const poems = await getPoems();
  const allSlugs = poems.map((p) => slugOf(p));
  return poems.map((poem, i) => ({
    params: { slug: slugOf(poem) },
    props: {
      poem,
      prev: poems[i + 1] ?? null,
      next: poems[i - 1] ?? null,
      allSlugs,
    },
  }));
}

const { poem, prev, next, allSlugs } = Astro.props;
const body = (poem.body ?? '').trim();
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = (Astro.site ?? new URL('https://thokieuoanh.com')).origin;
const poemUrl = `${siteUrl}/tho/${slugOf(poem)}/`;

// Poem schema — Google đọc được tựa, tác giả, ngày đăng, chủ đề.
// Tự sinh từ frontmatter nên bài mới không cần thêm gì.
const poemSchema = {
  '@type': 'Poem',
  '@id': `${poemUrl}#poem`,
  name: poem.data.title,
  headline: poem.data.title,
  url: poemUrl,
  datePublished: poem.data.date.toISOString().slice(0, 10),
  inLanguage: 'vi',
  author: { '@id': `${siteUrl}/#person` },
  isPartOf: { '@id': `${siteUrl}/#website` },
  ...(poem.data.tags.length ? { keywords: poem.data.tags.join(', '), about: poem.data.tags.map((t) => ({ '@type': 'Thing', name: t })) } : {}),
  ...(poem.data.excerpt ? { description: poem.data.excerpt.trim() } : {}),
};
---

<Base
  title={poem.data.title}
  description={metaDescriptionOf(poem)}
  current="/tho/"
  ogType="article"
  schema={poemSchema}
>
  <article class="poem-page wrap" data-pagefind-body data-pagefind-filter="section:tho">
    <header class="poem-page__header reveal">
      <h1 class="poem-page__title">{poem.data.title}</h1>
      <p class="poem-page__meta">
        <time datetime={poem.data.date.toISOString()}>{formatDate(poem.data.date)}</time>
      </p>
      {/*
        Chỉnh cỡ chữ — kiểu A (A− / A+).
        Đặt ngay dưới ngày đăng, trước bài thơ: chỗ mắt gặp đầu tiên.
        Cỡ đã chọn lưu vào localStorage nên mở bài khác vẫn giữ.
        Không hiện khi in (print) và không tính vào Pagefind.
      */}
      <div class="font-ctl" data-font-ctl data-pagefind-ignore>
        <button type="button" data-font-step="-1" aria-label="Chữ nhỏ hơn">A−</button>
        <span class="font-ctl__state" data-font-state aria-live="polite">vừa</span>
        <button type="button" data-font-step="1" aria-label="Chữ lớn hơn">A+</button>
      </div>
    </header>

    <div class="poem-page__body reveal" style="animation-delay: 80ms">{body}</div>

    {
      poem.data.tags.length > 0 && (
        <ul class="tag-list poem-page__tags">
          {poem.data.tags.map((t) => (
            <li>
              <a class="tag" href={`${BASE}/chu-de/${tagSlug(t)}/`}>
                {t}
              </a>
            </li>
          ))}
        </ul>
      )
    }

    <div class="rule-ornament" aria-hidden="true">
      <Ink name="flower" width={20} />
    </div>

    <nav class="poem-nav" aria-label="Bài trước và bài sau">
      {prev ? <a href={`${BASE}/tho/${slugOf(prev)}/`}>← {prev.data.title}</a> : <span></span>}
      {next ? <a href={`${BASE}/tho/${slugOf(next)}/`}>{next.data.title} →</a> : <span></span>}
    </nav>

    {/*
      Nút "Đọc ngẫu nhiên" — nằm ngay trên "Về kho thơ".
      Site là tĩnh nên chọn bài ở phía trình duyệt: danh sách slug được
      nhúng sẵn, bấm thì bốc một bài, loại trừ bài đang đọc để lần nào
      bấm cũng thật sự sang chỗ khác.
    */}
    <p class="poem-draw">
      <button
        type="button"
        class="poem-draw__btn"
        data-draw
        data-draw-current={slugOf(poem)}
        data-draw-base={BASE}
        data-draw-slugs={JSON.stringify(allSlugs)}
      >
        Đọc ngẫu nhiên
      </button>
    </p>

    <p style="text-align: center; margin-top: var(--s-3);">
      <a href={`${BASE}/tho/`} style="font-size: var(--step--1); letter-spacing: 0.06em;">Về kho thơ</a>
    </p>
  </article>
</Base>

<style>
  .poem-nav {
    display: flex;
    justify-content: space-between;
    gap: var(--s-4);
    padding-top: var(--s-4);
    border-top: 1px solid var(--rule);
    font-size: var(--step--1);
    color: var(--ink-faint);
  }
  .poem-nav a {
    text-decoration: none;
    max-width: 45%;
    color: var(--ink-soft);
  }
  .poem-nav a:last-child {
    text-align: right;
    margin-left: auto;
  }
  .poem-nav a:hover {
    color: var(--moss-deep);
  }

  /* Nút Đọc ngẫu nhiên — kiểu chữ nhỏ, nhẹ, cùng tông với dòng "Về kho thơ"
     để không tranh chỗ với bài thơ. Vẫn đủ 44px để ngón tay bấm dễ. */
  .poem-draw {
    text-align: center;
    margin-top: var(--s-5);
    margin-bottom: 0;
  }
  .poem-draw__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 var(--s-4);
    font: inherit;
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    color: var(--moss-deep);
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: 999px;
    cursor: pointer;
    transition: border-color 200ms ease, background-color 200ms ease, color 200ms ease;
  }
  .poem-draw__btn:hover {
    border-color: var(--moss);
    background: color-mix(in srgb, var(--moss) 8%, transparent);
  }
  .poem-draw__btn:active {
    transform: translateY(1px);
  }
  .poem-draw__btn:focus-visible {
    outline: 2px solid var(--moss);
    outline-offset: 3px;
  }
  @media print {
    .poem-draw { display: none; }
  }
</style>

<script>
  // ---- Đọc ngẫu nhiên ----
  // Danh sách slug do Astro nhúng vào data-draw-slugs. Bốc một bài,
  // bỏ bài đang đọc; nếu chỉ còn đúng một bài (site một bài) thì thôi.
  document.querySelectorAll<HTMLButtonElement>('[data-draw]').forEach((btn) => {
    btn.addEventListener('click', () => {
      let slugs: string[] = [];
      try {
        slugs = JSON.parse(btn.dataset.drawSlugs || '[]');
      } catch {
        slugs = [];
      }
      if (slugs.length < 2) return;

      const current = btn.dataset.drawCurrent || '';
      const base = btn.dataset.drawBase || '';
      const pool = slugs.filter((s) => s !== current);
      const pick = pool[Math.floor(Math.random() * pool.length)];
      if (!pick) return;

      window.location.href = `${base}/tho/${pick}/`;
    });
  });
</script>
