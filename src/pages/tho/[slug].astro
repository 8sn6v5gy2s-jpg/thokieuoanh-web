---
import fs from 'node:fs';
import Base from '../../layouts/Base.astro';
import Ink from '../../components/Ink.astro';
import {
  getPoems,
  slugOf,
  formatDate,
  tagSlug,
  metaDescriptionOf,
} from '../../lib/poems';

export async function getStaticPaths() {
  const poems = await getPoems();
  const allSlugs = poems.map((p) => slugOf(p));
  return poems.map((poem, i) => ({
    params: { slug: slugOf(poem) },
    props: {
      poem,
      prev: poems[i + 1] ?? null,
      next: poems[i - 1] ?? null,
      allSlugs,
    },
  }));
}

const { poem, prev, next, allSlugs } = Astro.props;
const body = (poem.body ?? '').trim();
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
// Bài có tệp âm thanh thì hiện trình nghe. Không sửa frontmatter:
// thả public/audio/<slug>.mp3 là có, không có tệp thì không hiện.
const audioSrc = fs.existsSync(`public/audio/${slugOf(poem)}.mp3`)
  ? `/audio/${slugOf(poem)}.mp3`
  : null;
const siteUrl = (Astro.site ?? new URL('https://thokieuoanh.pages.dev')).origin;
const poemUrl = `${siteUrl}/tho/${slugOf(poem)}/`;

// Poem schema — Google đọc được tựa, tác giả, ngày đăng, chủ đề.
// Tự sinh từ frontmatter nên bài mới không cần thêm gì.
const poemSchema = {
  '@type': 'Poem',
  '@id': `${poemUrl}#poem`,
  name: poem.data.title,
  headline: poem.data.title,
  url: poemUrl,
  datePublished: poem.data.date.toISOString().slice(0, 10),
  inLanguage: 'vi',
  author: { '@id': `${siteUrl}/#person` },
  isPartOf: { '@id': `${siteUrl}/#website` },
  ...(poem.data.tags.length ? { keywords: poem.data.tags.join(', '), about: poem.data.tags.map((t) => ({ '@type': 'Thing', name: t })) } : {}),
  ...(poem.data.excerpt ? { description: poem.data.excerpt.trim() } : {}),
};
---

<Base
  title={poem.data.title}
  description={metaDescriptionOf(poem)}
  current="/tho/"
  ogType="article"
  schema={poemSchema}
>
  <article class="poem-page wrap" data-pagefind-body data-pagefind-filter="section:tho">
    <header class="poem-page__header reveal">
      <h1 class="poem-page__title">{poem.data.title}</h1>
      <p class="poem-page__meta">
        <time datetime={poem.data.date.toISOString()}>{formatDate(poem.data.date)}</time>
      </p>
      {/*
        Chỉnh cỡ chữ — kiểu A (A− / A+).
        Đặt ngay dưới ngày đăng, trước bài thơ: chỗ mắt gặp đầu tiên.
        Cỡ đã chọn lưu vào localStorage nên mở bài khác vẫn giữ.
        Không hiện khi in (print) và không tính vào Pagefind.
      */}
      <div class="poem-tools" data-pagefind-ignore>
        <div class="font-ctl" data-font-ctl>
          <button type="button" data-font-step="-1" aria-label="Chữ nhỏ hơn">A−</button>
          <span class="font-ctl__state" data-font-state aria-live="polite">vừa</span>
          <button type="button" data-font-step="1" aria-label="Chữ lớn hơn">A+</button>
        </div>

        {audioSrc && (
          <div class="audio-ctl" data-audio>
            <button type="button" class="audio-ctl__play" data-audio-toggle
                    aria-label="Nghe bài thơ" aria-pressed="false">
              <svg class="audio-ctl__icon audio-ctl__icon--play" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <path d="M4 2.6v10.8L13.4 8 4 2.6z" fill="currentColor" />
              </svg>
              <svg class="audio-ctl__icon audio-ctl__icon--pause" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <rect x="3.4" y="2.6" width="3.2" height="10.8" rx="1" fill="currentColor" />
                <rect x="9.4" y="2.6" width="3.2" height="10.8" rx="1" fill="currentColor" />
              </svg>
            </button>

            <input class="audio-ctl__seek" data-audio-seek type="range"
                   min="0" max="100" value="0" step="0.1" aria-label="Tiến trình bài đọc" />

            <span class="audio-ctl__time" data-audio-time>0:00</span>

            <button type="button" class="audio-ctl__rate" data-audio-rate data-rate="1"
                    aria-label="Tốc độ đọc: 1 lần">1×</button>

            <audio data-audio-el preload="none" src={`${BASE}${audioSrc}`}></audio>
          </div>
        )}
      </div>
    </header>

    <div class="poem-page__body reveal" style="animation-delay: 80ms">{body}</div>

    {
      poem.data.tags.length > 0 && (
        <ul class="tag-list poem-page__tags">
          {poem.data.tags.map((t) => (
            <li>
              <a class="tag" href={`${BASE}/chu-de/${tagSlug(t)}/`}>
                {t}
              </a>
            </li>
          ))}
        </ul>
      )
    }

    <div class="rule-ornament" aria-hidden="true">
      <Ink name="flower" width={20} />
    </div>

    <nav class="poem-nav" aria-label="Bài trước và bài sau">
      {prev ? <a href={`${BASE}/tho/${slugOf(prev)}/`}>← {prev.data.title}</a> : <span></span>}
      {next ? <a href={`${BASE}/tho/${slugOf(next)}/`}>{next.data.title} →</a> : <span></span>}
    </nav>

    {/*
      Hàng nút cuối bài: Chia sẻ đứng trước, Đọc ngẫu nhiên sau.
      Đọc xong bài thì chia sẻ là ý tự nhiên hơn nhảy sang bài khác.
    */}
    <div class="poem-actions">
      <button
        type="button"
        class="poem-action"
        data-share
        data-share-title={poem.data.title}
        data-share-text={`${poem.data.title} — thơ Kiều Oanh`}
        data-share-url={`${siteUrl}/tho/${slugOf(poem)}/`}
      >
        Chia sẻ
      </button>

      {/*
        Nút "Đọc ngẫu nhiên" — nằm cạnh "Chia sẻ".
        Site là tĩnh nên chọn bài ở phía trình duyệt: danh sách slug được
        nhúng sẵn, bấm thì bốc một bài, loại trừ bài đang đọc để lần nào
        bấm cũng thật sự sang chỗ khác.
      */}
      <button
        type="button"
        class="poem-action"
        data-draw
        data-draw-current={slugOf(poem)}
        data-draw-base={BASE}
        data-draw-slugs={JSON.stringify(allSlugs)}
      >
        Đọc ngẫu nhiên
      </button>
    </div>

    {/* Thông báo nhỏ sau khi bấm Chia sẻ — trình đọc màn hình đọc lên. */}
    <p class="poem-action__note" data-share-note aria-live="polite"></p>

    <p style="text-align: center; margin-top: var(--s-3);">
      <a href={`${BASE}/tho/`} style="font-size: var(--step--1);">Về kho thơ</a>
    </p>
  </article>
</Base>

<style>
  /* Hàng công cụ: cỡ chữ + trình nghe, một dòng, canh trái. */
  .poem-tools {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: flex-start;
    gap: var(--s-2);
    margin-top: var(--s-3);
  }
  .poem-tools .font-ctl { margin-top: 0; }

  /* Trình nghe — cùng kiểu "viên thuốc" với .font-ctl */
  .audio-ctl {
    display: inline-flex;
    align-items: center;
    gap: 0.1rem;
    padding: 0.15rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--paper-soft);
    flex: 0 1 auto;
    min-width: 0;
    transition: border-color 0.2s ease;
  }
  .audio-ctl.is-playing { border-color: color-mix(in srgb, var(--moss) 45%, var(--rule)); }
  .audio-ctl__play {
    display: grid;
    place-items: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--ink-faint);
    cursor: pointer;
    flex: 0 0 auto;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .audio-ctl__play:hover { background: var(--paper-edge); color: var(--moss-deep); }
  .audio-ctl__play:focus-visible { outline: 2px solid var(--moss); outline-offset: 2px; }
  /* Đang tải trọn tệp trước khi phát (iOS cần 206, Pages không trả) */
  .audio-ctl__play[aria-busy="true"] { opacity: 0.55; cursor: progress; }
  /* Trạng thái quyết định biểu tượng: chỉ một cái hiện, đọc từ aria-pressed.
     Cả hai SVG đều display:none cho tới khi trạng thái bật một cái, nên
     không quy tắc nào để cả hai cùng hiện. */
  .audio-ctl__play svg { display: none; width: 19.5px; height: 19.5px; }
  .audio-ctl__play[aria-pressed="false"] .audio-ctl__icon--play { display: block; }
  .audio-ctl__play[aria-pressed="true"]  .audio-ctl__icon--pause { display: block; }

  /* Thanh tiến trình — mảnh, tô moss, núm chỉ hiện khi rê/kéo */
  .audio-ctl__seek {
    -webkit-appearance: none;
    appearance: none;
    background: transparent;
    flex: 1 1 auto;
    min-width: 64px;
    width: clamp(64px, 22vw, 150px);
    height: 44px;
    margin: 0 0.1rem;
    cursor: pointer;
  }
  .audio-ctl__seek::-webkit-slider-runnable-track {
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(to right, var(--moss) var(--p, 0%), var(--rule) var(--p, 0%));
  }
  .audio-ctl__seek::-moz-range-track { height: 2px; border-radius: 2px; background: var(--rule); }
  .audio-ctl__seek::-moz-range-progress { height: 2px; border-radius: 2px; background: var(--moss); }
  .audio-ctl__seek::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 11px;
    height: 11px;
    margin-top: -4.5px;
    border-radius: 50%;
    background: var(--moss);
    border: 0;
    opacity: 0;
    transition: opacity 0.15s ease;
  }
  .audio-ctl__seek::-moz-range-thumb {
    width: 11px;
    height: 11px;
    border: 0;
    border-radius: 50%;
    background: var(--moss);
    opacity: 0;
  }
  .audio-ctl:hover .audio-ctl__seek::-webkit-slider-thumb,
  .audio-ctl__seek:focus-visible::-webkit-slider-thumb { opacity: 1; }
  .audio-ctl:hover .audio-ctl__seek::-moz-range-thumb,
  .audio-ctl__seek:focus-visible::-moz-range-thumb { opacity: 1; }
  .audio-ctl__seek:focus-visible { outline: 2px solid var(--moss); outline-offset: 2px; border-radius: 999px; }

  .audio-ctl__time {
    font-family: var(--sans);
    font-size: 0.7rem;
    letter-spacing: 0.02em;
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
    min-width: 2.6em;
    text-align: center;
  }
  .audio-ctl__rate {
    min-width: 44px;
    min-height: 44px;
    padding: 0 0.35rem;
    border: 0;
    border-radius: 999px;
    background: none;
    font-family: var(--sans);
    font-size: 0.7rem;
    letter-spacing: 0.02em;
    color: var(--ink-faint);
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .audio-ctl__rate:hover { background: var(--paper-edge); color: var(--moss-deep); }
  .audio-ctl__rate:focus-visible { outline: 2px solid var(--moss); outline-offset: 2px; }
  .audio-ctl__rate[data-rate="1.25"] { color: var(--moss-deep); }

  @media (max-width: 26rem) {
    .poem-tools { gap: 0.4rem; }
    .audio-ctl__time { display: none; }
    .audio-ctl__seek { min-width: 44px; width: clamp(44px, 18vw, 110px); }
    .audio-ctl__rate { min-width: 40px; padding: 0 0.25rem; }
  }

  .poem-nav {
    display: flex;
    justify-content: space-between;
    gap: var(--s-4);
    padding-top: var(--s-4);
    border-top: 1px solid var(--rule);
    font-size: var(--step--1);
    color: var(--ink-faint);
  }
  .poem-nav a {
    text-decoration: none;
    max-width: 45%;
    color: var(--ink-soft);
  }
  .poem-nav a:last-child {
    text-align: right;
    margin-left: auto;
  }
  .poem-nav a:hover {
    color: var(--moss-deep);
  }

  /* Nút Đọc ngẫu nhiên — kiểu chữ nhỏ, nhẹ, cùng tông với dòng "Về kho thơ"
     để không tranh chỗ với bài thơ. Vẫn đủ 44px để ngón tay bấm dễ. */
  .poem-draw {
    text-align: center;
    margin-top: var(--s-5);
    margin-bottom: 0;
  }
  .poem-draw__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 var(--s-4);
    font: inherit;
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    color: var(--moss-deep);
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: 999px;
    cursor: pointer;
    transition: border-color 200ms ease, background-color 200ms ease, color 200ms ease;
  }
  .poem-draw__btn:hover {
    border-color: var(--moss);
    background: color-mix(in srgb, var(--moss) 8%, transparent);
  }
  .poem-draw__btn:active {
    transform: translateY(1px);
  }
  .poem-draw__btn:focus-visible {
    outline: 2px solid var(--moss);
    outline-offset: 3px;
  }
  /* Hàng nút cuối bài — Chia sẻ + Đọc ngẫu nhiên.
     Kiểu chữ nhỏ, cùng tông, viền mảnh như dòng "Về kho thơ" để không
     tranh chỗ với bài thơ. Cao 44px cho ngón tay. */
  .poem-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-3);
    margin-top: var(--s-5);
  }
  .poem-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 var(--s-4);
    font: inherit;
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    color: var(--moss-deep);
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: 999px;
    cursor: pointer;
    transition: border-color 200ms ease, background-color 200ms ease, color 200ms ease;
  }
  .poem-action:hover {
    border-color: var(--moss);
    background: color-mix(in srgb, var(--moss) 8%, transparent);
  }
  .poem-action:active {
    transform: translateY(1px);
  }
  .poem-action:focus-visible {
    outline: 2px solid var(--moss);
    outline-offset: 3px;
  }
  .poem-action__note {
    text-align: center;
    font-size: var(--step--2, 0.78rem);
    color: var(--ink-faint);
    min-height: 1.4em;
    margin-top: var(--s-2);
    margin-bottom: 0;
  }
  @media print {
    .poem-actions, .poem-action__note, .audio-ctl { display: none; }
  }
</style>

<script>
  // ---- Chia sẻ ----
  // Ưu tiên bảng chia sẻ của máy (Web Share API): trên điện thoại hiện
  // thẳng Zalo, Messenger, Tin nhắn… Trình duyệt không hỗ trợ hoặc không
  // phải thao tác người dùng thật (một số máy chặn) thì lùi về chép link.
  document.querySelectorAll<HTMLButtonElement>('[data-share]').forEach((btn) => {
    const note = document.querySelector<HTMLElement>('[data-share-note]');

    const say = (msg: string) => {
      if (note) note.textContent = msg;
      window.setTimeout(() => {
        if (note && note.textContent === msg) note.textContent = '';
      }, 4000);
    };

    const copyFallback = async (url: string) => {
      try {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(url);
        } else {
          // trình duyệt cũ: dùng ô nhập tạm
          const t = document.createElement('textarea');
          t.value = url;
          t.setAttribute('readonly', '');
          t.style.position = 'fixed';
          t.style.opacity = '0';
          document.body.appendChild(t);
          t.select();
          document.execCommand('copy');
          document.body.removeChild(t);
        }
        say('Đã chép link bài thơ.');
      } catch {
        say('Không chép được. Bạn copy link trên thanh địa chỉ nhé.');
      }
    };

    btn.addEventListener('click', async () => {
      const url = btn.dataset.shareUrl || window.location.href;
      const title = btn.dataset.shareTitle || document.title;
      const text = btn.dataset.shareText || title;

      if (navigator.share) {
        try {
          await navigator.share({ title, text, url });
          return;
        } catch (err) {
          // người dùng bấm huỷ thì im lặng, không làm gì
          if (err instanceof DOMException && err.name === 'AbortError') return;
          // lỗi khác thì thử cách chép link
        }
      }
      await copyFallback(url);
    });
  });

  // ---- Đọc ngẫu nhiên ----
  // Danh sách slug do Astro nhúng vào data-draw-slugs. Bốc một bài,
  // bỏ bài đang đọc; nếu chỉ còn đúng một bài (site một bài) thì thôi.
  document.querySelectorAll<HTMLButtonElement>('[data-draw]').forEach((btn) => {
    btn.addEventListener('click', () => {
      let slugs: string[] = [];
      try {
        slugs = JSON.parse(btn.dataset.drawSlugs || '[]');
      } catch {
        slugs = [];
      }
      if (slugs.length < 2) return;

      const current = btn.dataset.drawCurrent || '';
      const base = btn.dataset.drawBase || '';
      const pool = slugs.filter((s) => s !== current);
      const pick = pool[Math.floor(Math.random() * pool.length)];
      if (!pick) return;

      window.location.href = `${base}/tho/${pick}/`;
    });
  });

  // ---- Trình nghe ----
  // Nút đổi biểu tượng theo aria-pressed; tốc độ lưu theo máy như cỡ chữ.
  document.querySelectorAll<HTMLElement>('[data-audio]').forEach((box) => {
    const el = box.querySelector<HTMLAudioElement>('[data-audio-el]');
    const btn = box.querySelector<HTMLButtonElement>('[data-audio-toggle]');
    const seek = box.querySelector<HTMLInputElement>('[data-audio-seek]');
    const time = box.querySelector<HTMLElement>('[data-audio-time]');
    const rate = box.querySelector<HTMLButtonElement>('[data-audio-rate]');
    if (!el || !btn || !seek || !time || !rate) return;

    const rates = [1, 1.25];
    let r = Number(localStorage.getItem('ko-audio-rate') || 1);
    if (!rates.includes(r)) r = 1;

    // Cloudflare Pages trả 200 cho Range, không có 206. iOS Safari cần 206 để
    // phát và tua, nên tải trọn tệp rồi phát từ blob: lúc đó tua là chuyện
    // nội bộ của máy. Tải hỏng thì quay lại phát thẳng từ URL gốc.
    const nativeSrc = el.getAttribute('src') || '';
    let blobUrl: string | null = null;
    let loading: Promise<void> | null = null;

    const loadWhole = () => {
      if (!loading) {
        loading = (async () => {
          btn.setAttribute('aria-busy', 'true');
          try {
            const res = await fetch(nativeSrc, { cache: 'force-cache' });
            if (!res.ok) throw new Error(String(res.status));
            blobUrl = URL.createObjectURL(await res.blob());
            el.src = blobUrl as string;
            el.load();
            await new Promise<void>((resolve) => {
              if (el.readyState >= 1) return resolve();
              el.addEventListener('loadedmetadata', () => resolve(), { once: true });
              el.addEventListener('error', () => resolve(), { once: true });
            });
          } catch {
            /* để nguyên src gốc */
          } finally {
            btn.removeAttribute('aria-busy');
          }
        })();
      }
      return loading;
    };

    const mmss = (s: number) => {
      if (!isFinite(s)) s = 0;
      return Math.floor(s / 60) + ':' + String(Math.floor(s % 60)).padStart(2, '0');
    };

    const paintRate = () => {
      el.playbackRate = r;
      rate.dataset.rate = String(r);
      rate.textContent = r + '×';
      rate.setAttribute('aria-label', 'Tốc độ đọc: ' + (r === 1 ? '1 lần' : '1,25 lần') + '. Bấm để đổi.');
    };

    const paintProgress = () => {
      const d = el.duration || 0;
      seek.value = d ? String((el.currentTime / d) * 100) : '0';
      seek.style.setProperty('--p', (d ? (el.currentTime / d) * 100 : 0) + '%');
      time.textContent = mmss(el.currentTime);
    };

    btn.addEventListener('click', async () => {
      if (el.paused) {
        await loadWhole();
        try {
          await el.play();
        } catch {
          /* bị chặn thì thôi */
        }
      } else {
        el.pause();
      }
    });
    el.addEventListener('play', () => {
      box.classList.add('is-playing');
      btn.setAttribute('aria-pressed', 'true');
      btn.setAttribute('aria-label', 'Tạm dừng bài đọc');
    });
    el.addEventListener('pause', () => {
      box.classList.remove('is-playing');
      btn.setAttribute('aria-pressed', 'false');
      btn.setAttribute('aria-label', 'Nghe bài thơ');
    });
    el.addEventListener('timeupdate', paintProgress);
    el.addEventListener('loadedmetadata', () => {
      paintRate();
      paintProgress();
    });
    el.addEventListener('ended', () => {
      el.currentTime = 0;
      paintProgress();
    });
    seek.addEventListener('input', () => {
      const d = el.duration || 0;
      if (!d) return;
      el.currentTime = (Number(seek.value) / 100) * d;
      seek.style.setProperty('--p', seek.value + '%');
      time.textContent = mmss(el.currentTime);
    });
    rate.addEventListener('click', () => {
      r = rates[(rates.indexOf(r) + 1) % rates.length];
      localStorage.setItem('ko-audio-rate', String(r));
      paintRate();
    });
    paintRate();
    paintProgress();
    window.addEventListener('pagehide', () => {
      el.pause();
      if (blobUrl) URL.revokeObjectURL(blobUrl);
    });
  });
</script>
