---
import Base from '../layouts/Base.astro';
import Ink from '../components/Ink.astro';
import PoemCard from '../components/PoemCard.astro';
import { getPoems, slugOf, excerptOf, collectTags } from '../lib/poems';

const poems = await getPoems();
const tags = collectTags(poems).slice(0, 6);

// "Bài chọn": lấy từ frontmatter `featured: true`, không bù bằng bài mới nhất.
// Bù thì nhãn "Bài chọn" thành lời nói dối. Bài mới được đánh dấu tự vào đây,
// không cần sửa code.
const picks = poems.filter((p) => p.data.featured).slice(0, 3);

// "Mới nhất" không lặp lại bài đã nằm trong Bài chọn.
const recent = poems.filter((p) => !picks.includes(p)).slice(0, 3);
const total = poems.length;

// Bài thơ chốt trang: đọc nguyên bài, không phải trích hai dòng.
// Ưu tiên `closing: true`; nếu chưa đánh dấu thì chọn bài ngắn nhất chưa
// xuất hiện ở hai khối trên — đủ ngắn để đứng trọn ở cuối trang.
const used = new Set([...picks, ...recent]);
const candidates = poems.filter((p) => !used.has(p));
const lineCount = (p) => (p.body ?? '').split('\n').filter((l) => l.trim()).length;
const closing =
  poems.find((p) => p.data.closing) ??
  candidates.sort((a, b) => lineCount(a) - lineCount(b))[0] ??
  poems[0];
const closingBody = (closing.body ?? '').trim();

const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base
  current="/"
  title="Thơ Kiều Oanh — lưu giữ từng kỷ niệm"
  description="Tuyển tập những bài thơ của Kiều Oanh: về gia đình, quê hương, bốn mùa và những kỷ niệm trong cuộc sống. Mong bạn có những phút giây yên bình tại thơ Kiều Oanh."
>
  <section class="hero wrap wrap--narrow">
    <div class="hero__portrait">
      <img
        src={`${BASE}/images/kieuoanh-square.jpg`}
        alt="Kiều Oanh"
        width="900"
        height="900"
        loading="eager"
        decoding="async"
      />
      <div class="hero__portrait-ring" aria-hidden="true"></div>
    </div>

    <h1 class="hero__title">Thơ Kiều Oanh</h1>
    <p class="hero__tagline">
      Viết thơ mấy chục năm, gần như không để ai đọc. Đây là lần đầu gom lại.
    </p>
  </section>

  {
    picks.length > 0 && (
      <section class="wrap wrap--narrow" aria-labelledby="featured-heading">
        <h2 class="picks__section-title" id="featured-heading">Bài chọn</h2>

        {/* Ba bài xếp thành cột, không khung, không băng chuyền, không JS.
            Bài thơ là thứ để đọc, không phải để vuốt qua. */}
        <div class="picks">
          {picks.map((poem) => (
            <article class="picks__item">
              <h2 class="picks__title">
                <a href={`${BASE}/tho/${slugOf(poem)}/`}>{poem.data.title}</a>
              </h2>
              <p class="picks__excerpt">{excerptOf(poem)}</p>
              <a class="picks__link" href={`${BASE}/tho/${slugOf(poem)}/`}>
                Đọc bài
              </a>
            </article>
          ))}
        </div>
      </section>
    )
  }

  <div class="wrap wrap--narrow">
    <div class="rule-ornament" aria-hidden="true">
      <Ink name="flower" width={22} />
    </div>
  </div>

  {
    recent.length > 0 && (
      <section class="wrap" aria-labelledby="recent-heading">
        <h2 class="section-title" id="recent-heading">Thơ gần đây</h2>
        <ul class="poem-grid">
          {recent.map((poem, i) => (
            <PoemCard poem={poem} delay={i * 60} />
          ))}
        </ul>
        <p style="margin-top: var(--s-5);">
          <a
            href={`${BASE}/tho/`}
            style="font-size: var(--step--1); letter-spacing: 0.08em; text-transform: uppercase; text-decoration: none; border-bottom: 1px solid color-mix(in srgb, var(--moss) 45%, transparent); padding-bottom: 0.2em;"
          >
            Xem toàn bộ {total} bài
          </a>
        </p>
      </section>
    )
  }

  {
    tags.length > 0 && (
      <section class="wrap" aria-labelledby="tags-heading" style="margin-top: var(--s-7);">
        <h2 class="section-title" id="tags-heading">Đọc theo mạch</h2>
        <ul class="tag-list">
          {tags.map((t) => (
            <li>
              <a class="tag" href={`${BASE}/chu-de/${t.slug}/`}>
                {t.count >= 3 ? `${t.name} · ${t.count}` : t.name}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {/* Chốt trang bằng một bài thơ nguyên vẹn, không phải lời cảm ơn.
      Lời cảm ơn đã chuyển xuống footer. */}
  <section class="wrap wrap--narrow closing" aria-labelledby="closing-heading">
    <div class="rule-ornament" aria-hidden="true">
      <Ink name="branch" width={140} />
    </div>
    <h2 class="closing__title" id="closing-heading">
      <a href={`${BASE}/tho/${slugOf(closing)}/`}>{closing.data.title}</a>
    </h2>
    <div class="closing__body">{closingBody}</div>
    <p class="closing__more">
      <a href={`${BASE}/tho/${slugOf(closing)}/`}>Đọc trọn bài</a>
    </p>
  </section>
</Base>

<style>
  .hero__portrait {
    position: relative;
    width: clamp(112px, 17vw, 152px);
    aspect-ratio: 1;
    margin: 0 auto var(--s-4);
  }
  .hero__portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    display: block;
    filter: saturate(0.94) contrast(1.02);
  }
  /* vòng chỉ mảnh ngoài ảnh, lệch nhẹ cho có vẻ tay vẽ */
  .hero__portrait-ring {
    position: absolute;
    inset: -7px;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--moss) 32%, transparent);
    transform: rotate(-1.2deg);
  }

  /* ---------- Bài chọn: cột dọc, không khung ---------- */
  .picks {
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 6vw, 4rem);
  }
  .picks__section-title {
    font-family: var(--sans);
    font-size: var(--step--1);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--clay);
    font-weight: 500;
    text-align: center;
    margin-bottom: var(--s-6);
  }
  .picks__item {
    text-align: center;
  }
  .picks__title {
    font-size: var(--step-2);
    font-weight: 400;
    letter-spacing: -0.01em;
    margin-bottom: var(--s-3);
  }
  .picks__title a {
    text-decoration: none;
    color: var(--ink);
  }
  .picks__title a:hover {
    color: var(--moss-deep);
  }
  .picks__excerpt {
    font-style: italic;
    color: var(--ink-soft);
    max-width: 30rem;
    margin-inline: auto;
    line-height: 1.85;
    white-space: pre-line;
  }
  .picks__link {
    display: inline-block;
    margin-top: var(--s-4);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--moss-deep);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--moss) 45%, transparent);
    padding-bottom: 0.2em;
  }
  .picks__link:hover {
    border-bottom-color: var(--moss);
  }

  /* ---------- Chốt trang ---------- */
  .closing {
    margin-top: var(--s-7);
    text-align: center;
  }
  .closing__title {
    font-size: var(--step-2);
    font-weight: 400;
    letter-spacing: -0.01em;
    margin-top: var(--s-5);
    margin-bottom: var(--s-4);
  }
  .closing__title a {
    text-decoration: none;
    color: var(--ink);
  }
  .closing__title a:hover {
    color: var(--moss-deep);
  }
  .closing__body {
    font-size: var(--poem-fs, clamp(1.02rem, 0.94rem + 0.4vw, 1.16rem));
    line-height: 2;
    color: var(--ink);
    max-width: 30rem;
    margin-inline: auto;
    white-space: pre-line;
    text-wrap: pretty;
  }
  .closing__more {
    margin-top: var(--s-5);
    font-size: var(--step--1);
  }
</style>
